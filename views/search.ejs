<%- include('partials/header', { title: 'Discover' }) %>
<%- include('partials/navbar', { activePage: 'search' }) %>

<div class="container" style="padding-top:48px;padding-bottom:80px;">

  <!-- ── Page header ────────────────────────────────────────── -->
  <div style="text-align:center;margin-bottom:44px;">
    <p class="hero-eyebrow" style="justify-content:center;">
      Google Books + Open Library
    </p>
    <h1 style="font-size:clamp(1.8rem,4vw,2.6rem);margin-bottom:10px;">
      Find your next <em class="serif-italic" style="color:var(--accent);">great read</em>
    </h1>
    <p style="color:var(--text-2);font-size:14.5px;max-width:380px;margin:0 auto 28px;">
      Search millions of titles, see community ratings, and save to your shelf in one tap.
    </p>
    <form action="/search/query" method="GET">
      <div class="search-bar">
        <input type="text" name="q"
          value="<%= typeof query !== 'undefined' ? query : '' %>"
          placeholder="Title, author, or keyword…"
          required autocomplete="off" />
        <button type="submit" aria-label="Search">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </button>
      </div>
    </form>
  </div>

  <!-- ── Saved confirmation ──────────────────────────────────── -->
  <% if (locals.saved) { %>
    <div style="text-align:center;margin-bottom:28px;">
      <span class="badge badge-gold" style="font-size:13px;padding:8px 20px;">✓ Book saved to your library!</span>
    </div>
  <% } %>

  <!-- ── Results ─────────────────────────────────────────────── -->
  <% if (typeof results !== 'undefined' && results.length > 0) { %>

    <div class="flex items-c justify-b mb-3">
      <p class="section-label" style="margin-bottom:0;">
        Results for &ldquo;<%= query %>&rdquo;
      </p>
      <div style="display:flex;align-items:center;gap:8px;">
        <span class="text-muted text-sm"><%= results.length %> titles</span>
        <!-- Source badge -->
        <% if (source === 'google') { %>
          <span style="font-size:10.5px;font-weight:600;padding:3px 9px;border-radius:99px;
                       background:rgba(66,133,244,0.12);color:#4a90d9;border:1px solid rgba(66,133,244,0.2);">
            via Google Books
          </span>
        <% } else { %>
          <span style="font-size:10.5px;font-weight:600;padding:3px 9px;border-radius:99px;
                       background:var(--lilac-soft);color:var(--lilac);border:1px solid rgba(155,142,196,0.2);">
            via Open Library
          </span>
        <% } %>
      </div>
    </div>

    <div class="book-grid stagger">
      <% results.forEach(function(book, idx) { %>
        <div class="book-card">

          <!-- Cover -->
          <div class="book-cover">
            <% if (book.coverUrl) { %>
              <img src="<%= book.coverUrl %>" alt="<%= book.title %>" loading="lazy" />
            <% } else { %>
              <div class="book-cover-placeholder">📚</div>
            <% } %>
          </div>

          <!-- Meta -->
          <div class="book-meta">
            <div class="book-title"><%= book.title %></div>
            <div class="book-author">
              <%= book.author || 'Unknown author' %>
              <% if (book.publishYear) { %>&nbsp;·&nbsp;<%= book.publishYear %><% } %>
            </div>

            <!-- Page count if available (Google Books) -->
            <% if (book.pageCount) { %>
              <div style="font-size:11px;color:var(--text-3);margin-top:3px;">
                <%= book.pageCount %> pages
              </div>
            <% } %>

            <!-- Community rating from our DB -->
            <% if (book.avgRating && book.ratingCount) { %>
              <div class="star-display mt-1">
                <% for(var s=1;s<=5;s++){ %>
                  <span class="star <%= s <= Math.round(book.avgRating) ? 'filled' : '' %>">★</span>
                <% } %>
                <span class="rating-count"><%= book.avgRating.toFixed(1) %> (<%= book.ratingCount %>)</span>
              </div>
            <% } else { %>
              <div class="star-display mt-1">
                <% for(var s=0;s<5;s++){ %><span class="star">★</span><% } %>
                <span class="rating-count">No ratings yet</span>
              </div>
            <% } %>
          </div>

          <!-- Actions -->
          <% if (locals.currentUser) { %>
            <div class="book-actions">

              <!-- Rate -->
              <form action="/books/rate" method="POST">
                <input type="hidden" name="openLibraryId" value="<%= book.openLibraryId || '' %>" />
                <input type="hidden" name="googleBooksId" value="<%= book.googleBooksId || '' %>" />
                <input type="hidden" name="title"         value="<%= book.title %>" />
                <input type="hidden" name="author"        value="<%= book.author || '' %>" />
                <input type="hidden" name="coverUrl"      value="<%= book.coverUrl || '' %>" />
                <input type="hidden" name="publishYear"   value="<%= book.publishYear || '' %>" />
                <input type="hidden" name="description"   value="<%= (book.description||'').substring(0,500) %>" />
                <input type="hidden" name="redirect"      value="/search/query?q=<%= encodeURIComponent(query) %>" />
                <div class="star-rating mb-1" id="sr-<%= idx %>">
                  <% for(var s=1;s<=5;s++){ %>
                    <span class="star" data-val="<%= s %>"
                          onclick="pickStarSearch(this,'<%= idx %>')">★</span>
                  <% } %>
                  <input type="hidden" name="rating" id="rv-<%= idx %>" value="" />
                </div>
                <button type="submit" class="btn btn-ghost btn-sm w-full" style="justify-content:center;font-size:11.5px;">Rate</button>
              </form>

              <!-- Reading now -->
              <form action="/books/reading-from-search" method="POST">
                <input type="hidden" name="openLibraryId" value="<%= book.openLibraryId || '' %>" />
                <input type="hidden" name="googleBooksId" value="<%= book.googleBooksId || '' %>" />
                <input type="hidden" name="title"         value="<%= book.title %>" />
                <input type="hidden" name="author"        value="<%= book.author || '' %>" />
                <input type="hidden" name="coverUrl"      value="<%= book.coverUrl || '' %>" />
                <input type="hidden" name="publishYear"   value="<%= book.publishYear || '' %>" />
                <input type="hidden" name="description"   value="<%= (book.description||'').substring(0,500) %>" />
                <button type="submit" class="btn btn-primary btn-sm w-full" style="justify-content:center;">📖 Reading now</button>
              </form>

              <!-- Favorite -->
              <form action="/books/favorite-from-search" method="POST">
                <input type="hidden" name="openLibraryId" value="<%= book.openLibraryId || '' %>" />
                <input type="hidden" name="googleBooksId" value="<%= book.googleBooksId || '' %>" />
                <input type="hidden" name="title"         value="<%= book.title %>" />
                <input type="hidden" name="author"        value="<%= book.author || '' %>" />
                <input type="hidden" name="coverUrl"      value="<%= book.coverUrl || '' %>" />
                <input type="hidden" name="publishYear"   value="<%= book.publishYear || '' %>" />
                <input type="hidden" name="description"   value="<%= (book.description||'').substring(0,500) %>" />
                <button type="submit" class="btn btn-ghost btn-sm w-full" style="justify-content:center;">★ Favorite</button>
              </form>

              <!-- Read next -->
              <form action="/books/readnext-from-search" method="POST">
                <input type="hidden" name="openLibraryId" value="<%= book.openLibraryId || '' %>" />
                <input type="hidden" name="googleBooksId" value="<%= book.googleBooksId || '' %>" />
                <input type="hidden" name="title"         value="<%= book.title %>" />
                <input type="hidden" name="author"        value="<%= book.author || '' %>" />
                <input type="hidden" name="coverUrl"      value="<%= book.coverUrl || '' %>" />
                <input type="hidden" name="publishYear"   value="<%= book.publishYear || '' %>" />
                <input type="hidden" name="description"   value="<%= (book.description||'').substring(0,500) %>" />
                <button type="submit" class="btn btn-ghost btn-sm w-full" style="justify-content:center;font-size:11.5px;">🔖 Read next</button>
              </form>

            </div>
          <% } else { %>
            <div style="padding:0 14px 14px;">
              <a href="/login" class="btn btn-ghost btn-sm w-full" style="justify-content:center;">Sign in to save</a>
            </div>
          <% } %>
        </div>
      <% }); %>
    </div>

  <% } else if (typeof query !== 'undefined' && query !== '') { %>
    <div class="empty-state">
      <div class="empty-icon">🔍</div>
      <h3>No results for &ldquo;<%= query %>&rdquo;</h3>
      <p>Try a different title or author name.</p>
    </div>
  <% } else { %>
    <!-- Initial state — suggested searches -->
    <div style="text-align:center;padding:20px 0 40px;">
      <p class="text-muted text-sm mb-3">Try searching for…</p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <% ['Dune','The Hobbit','1984','Beloved','Project Hail Mary','Intermezzo','James'].forEach(function(s){ %>
          <a href="/search/query?q=<%= encodeURIComponent(s) %>"
             class="badge badge-purple"
             style="font-size:13px;padding:8px 18px;cursor:pointer;transition:all 0.2s;">
            <%= s %>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

</div>

<script>
function pickStarSearch(el, idx) {
  var val       = parseInt(el.getAttribute('data-val'), 10);
  var container = document.getElementById('sr-' + idx);
  container.querySelectorAll('.star').forEach(function(s, i) {
    s.classList.toggle('filled', i < val);
  });
  document.getElementById('rv-' + idx).value = val;
}
</script>

</body>
</html>
