<nav class="navbar">
  <a href="/" class="navbar-logo">
    <span class="logo-dot"></span>
    BookLoop
  </a>

  <% if (locals.currentUser) { %>
    <a href="/home"    class="nav-link <%= locals.activePage === 'home'    ? 'active' : '' %>">Home</a>
    <a href="/feed"    class="nav-link <%= locals.activePage === 'feed'    ? 'active' : '' %>">Feed</a>
    <a href="/search"  class="nav-link <%= locals.activePage === 'search'  ? 'active' : '' %>">Discover</a>
    <a href="/friends" class="nav-link <%= locals.activePage === 'friends' ? 'active' : '' %>">Friends</a>
    <a href="/profile/<%= locals.sessionUser ? locals.sessionUser.username : '' %>"
       class="nav-link <%= locals.activePage === 'profile' ? 'active' : '' %>">Profile</a>
    <form action="/logout" method="POST" style="margin-left:4px;">
      <button type="submit" class="btn btn-ghost btn-sm">Sign out</button>
    </form>
  <% } else { %>
    <a href="/login"    class="nav-link">Sign in</a>
    <a href="/register" class="btn btn-primary btn-sm" style="margin-left:4px;">Join free</a>
  <% } %>

  <!-- Theme toggle -->
  <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme" title="Toggle light/dark mode">
    <!-- Moon (shown in dark mode) -->
    <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
    <!-- Sun (shown in light mode) -->
    <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"/>
      <line x1="12" y1="1"  x2="12" y2="3"/>
      <line x1="12" y1="21" x2="12" y2="23"/>
      <line x1="4.22"  y1="4.22"  x2="5.64"  y2="5.64"/>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
      <line x1="1"  y1="12" x2="3"  y2="12"/>
      <line x1="21" y1="12" x2="23" y2="12"/>
      <line x1="4.22"  y1="19.78" x2="5.64"  y2="18.36"/>
      <line x1="18.36" y1="5.64"  x2="19.78" y2="4.22"/>
    </svg>
  </button>
</nav>

<script>
  (function() {
    var btn = document.getElementById('themeToggle');
    if (!btn) return;
    btn.addEventListener('click', function() {
      var html    = document.documentElement;
      var current = html.getAttribute('data-theme') || 'dark';
      var next    = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('bl-theme', next);
    });
  })();
</script>